HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
SHEETS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
SHEETS_TOKEN=replace-with-a-long-random-secret
REQUEST_SYNC_DELAY_SECONDS=300
MANUAL_SYNC_COOLDOWN_SECONDS=30
MAX_LISTENERS=24
# Concurrent yt-dlp/FFmpeg jobs. Empty/0 uses max(1, min(8, CPU count - 1)).
DOWNLOAD_WORKERS=0
FFMPEG=ffmpeg
# Separate password for /debug (disabled when empty). Password-only sign-in; no username required.
TESTING_PASSWORD=
